# ============================================================
#  VIRALITY BOT — Fichier de configuration secret
#  1) Copie ce fichier et renomme la copie en :  .env
#  2) Remplis les valeurs ci-dessous
#  3) NE PARTAGE JAMAIS ton fichier .env (il contient le token !)
# ============================================================

# Le token de ton bot (à récup sur https://discord.com/developers/applications
# -> ton application -> onglet "Bot" -> "Reset Token")
DISCORD_TOKEN=colle_ton_token_ici

# Le serveur discord sur lequel le bot fonctionne (déjà rempli, ne touche pas)
GUILD_ID=1562033502612885534

# Mot de passe pour te connecter au dashboard web (choisis-en un à toi)
DASHBOARD_PASSWORD=choisis_un_mot_de_passe

# Port du dashboard web -> http://localhost:3000
DASHBOARD_PORT=3000

# (Optionnel) Clé secrète pour les sessions du dashboard.
# Tu peux laisser vide : elle sera générée automatiquement au démarrage.
SESSION_SECRET=
